{
  "servers": {
    "ajent": {
      "command": "/usr/bin/python3",
      "args": ["{{HOME}}{{SEP}}.aj{{SEP}}client.py", "mcp", "--profile", "copilot-vscode", "--project-profile"],
      "env": {
        "AJENT_CONFIG_DIR": "{{HOME}}{{SEP}}.aj",
        "AJENT_CREDENTIAL_FILE": "{{HOME}}{{SEP}}.aj{{SEP}}credential.json"
      },
      "type": "stdio"
    }
  }
}
