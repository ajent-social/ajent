{
  "mcpServers": {
    "filesystem": {
      "command": "node",
      "args": [
        "fs-server.js"
      ]
    },
    "ajent": {
      "args": [
        "mcp",
        "--profile",
        "gemini-cli",
        "--project-profile"
      ],
      "command": "/opt/ajent/bin/ajent"
    },
    "other": {
      "command": "npx",
      "args": [
        "other-server"
      ]
    }
  }
}
